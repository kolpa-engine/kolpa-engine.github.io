<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#000000" />

  <title>{{ site.title }} - {{ page.title }}</title>

  <meta name="description" content="{{ page.description | default: site.description }}" />
  <meta name="keywords"
    content="kolpa engine, game engine, c++, c#, ecs, flecs, physics, box3d, opengl, sdl3, open source" />

  <meta name="author" content="Gabriel Aplok" />
  <meta name="application-name" content="Kolpa Engine" />
  <meta name="generator" content="Kolpa Static Site Generator" />
  <meta name="color-scheme" content="dark" />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  <!-- Canonical -->
  <link rel="canonical" href="https://kolpa-engine.github.io/{{ page.slug }}" />

  <!-- Open Graph -->
  <meta property="og:title" content="{{ site.title }} - {{ page.title }}" />
  <meta property="og:description" content="{{ page.description | default: site.description }}" />
  <meta property="og:type" content="{% if page.type %}{{ page.type }}{% else %}website{% endif %}" />
  <meta property="og:url" content="https://kolpa-engine.github.io/{{ page.slug }}" />
  <meta property="og:site_name" content="Kolpa Engine" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content="{% if page.image %}https://kolpa-engine.github.io{{ page.image }}{% else %}https://kolpa-engine.github.io/assets/icon.png{% endif %}" />
  <meta property="og:image:width" content="{% if page.image %}1200{% else %}512{% endif %}" />
  <meta property="og:image:height" content="{% if page.image %}630{% else %}512{% endif %}" />
  <meta property="og:image:alt" content="{% if page.image_alt %}{{ page.image_alt }}{% else %}Kolpa Engine Logo{% endif %}" />
  {% if page.author %}
    <meta property="article:author" content="{{ page.author }}" />
    <meta property="article:published_time" content="{{ page.date }}" />
  {% endif %}

  <!-- Twitter -->
  <meta name="twitter:card" content="{% if page.image %}summary_large_image{% else %}summary{% endif %}" />
  <meta name="twitter:title" content="{{ site.title }} - {{ page.title }}" />
  <meta name="twitter:description" content="{{ page.description | default: site.description }}" />
  <meta name="twitter:image" content="{% if page.image %}https://kolpa-engine.github.io{{ page.image }}{% else %}https://kolpa-engine.github.io/assets/icon.png{% endif %}" />
  <meta name="twitter:image:alt" content="{% if page.image_alt %}{{ page.image_alt }}{% else %}Kolpa Engine Logo{% endif %}" />

  <!-- PWA / Mobile -->
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Kolpa Engine" />

  <!-- Icons -->
  <link rel="icon" href="/assets/icon.png" sizes="512x512" type="image/png" />
  <link rel="shortcut icon" href="/assets/icon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/icon.png" />

  <!-- Styles -->
  <link rel="stylesheet" href="https://necolas.github.io/normalize.css/8.0.1/normalize.css">
  <link rel="stylesheet" href="{{ assets['styles/tokens.css'] | default: '/assets/styles/tokens.css' }}">
  <link rel="stylesheet" href="{{ assets['styles/kolpa.css'] | default: '/assets/styles/kolpa.css' }}">
  <link rel="stylesheet" href="/assets/highlight.css">

  <!-- Theme init (no flash) -->
  <script>
    (function () {
      var pref = null;
      try { pref = localStorage.getItem("kolpa-theme"); } catch (e) { }
      var light =
        pref === "light" ||
        (pref !== "dark" &&
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: light)").matches);
      document.documentElement.setAttribute("data-theme", light ? "light" : "dark");
    })();
  </script>
</head>

<body>
  <a class="skip-link" href="#overview">Skip to content</a>

  {% if site.showWarningBanner %}
    <div class="warning-banner" role="alert">
      <div class="shell warning-banner-content">
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="warning-banner-icon"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span>{{ site.warningBannerText }}</span>
      </div>
    </div>
  {% endif %}

  <header class="site-header">
    <div class="shell header-inner">
      <a class="logo" href="/">KOLPA</a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle" />

      <nav class="nav" aria-label="Primary Navigation">
        <a href="/showcases/">SHOWCASES</a>
        <a href="/modules/">MODULES</a>
        <a href="/blog/">BLOG</a>
        <a href="/download/">DOWNLOAD</a>
      </nav>

      <div class="theme-switch" role="radiogroup" aria-label="Color theme">
        <button type="button" role="radio" aria-checked="true" data-theme-pref="auto">Auto</button>
        <button type="button" role="radio" aria-checked="false" data-theme-pref="dark">Dark</button>
        <button type="button" role="radio" aria-checked="false" data-theme-pref="light">Light</button>
      </div>

      <a href="https://github.com/kolpa-engine" class="nav-git-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub Repository">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
      </a>

      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation menu">
        <svg class="menu-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <svg class="close-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </label>
    </div>
  </header>

  <main>
    {{ content }}
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div>
        <p class="footer-brand">KOLPA ENGINE</p>
        <p class="footer-note">
          Created by Gabriel Aplok &copy; <span id="y"></span>
        </p>
      </div>
      <nav class="footer-links" aria-label="Footer Navigation">
        <a href="/showcases/">SHOWCASES</a>
        <a href="/modules/">MODULES</a>
        <a href="/blog/">BLOG</a>
        <a href="/download/">DOWNLOAD</a>
        <a href="/team/">TEAM</a>
        <a href="https://github.com/kolpa-engine" target="_blank" rel="noopener noreferrer">GITHUB</a>
      </nav>
    </div>
  </footer>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.getElementById("y").textContent = new Date().getFullYear();

      // Theme switcher
      var STORAGE_KEY = "kolpa-theme";
      var root = document.documentElement;
      var mq = window.matchMedia("(prefers-color-scheme: light)");

      function effective(pref) {
        if (pref === "light" || pref === "dark") return pref;
        return mq.matches ? "light" : "dark";
      }

      function savedPref() {
        try {
          var v = localStorage.getItem(STORAGE_KEY);
          return v === "light" || v === "dark" || v === "auto" ? v : "auto";
        } catch (e) { return "auto"; }
      }

      function updateMeta(theme) {
        var tc = document.querySelector('meta[name="theme-color"]');
        var cs = document.querySelector('meta[name="color-scheme"]');
        if (tc) tc.setAttribute("content", theme === "light" ? "#fbfbfc" : "#000000");
        if (cs) cs.setAttribute("content", theme);
      }

      function updateButtons(pref) {
        document.querySelectorAll(".theme-switch [data-theme-pref]").forEach(function (b) {
          b.setAttribute("aria-checked", b.getAttribute("data-theme-pref") === pref ? "true" : "false");
        });
      }

      function apply(pref, save) {
        var theme = effective(pref);
        root.setAttribute("data-theme", theme);
        updateButtons(pref);
        updateMeta(theme);
        if (save) {
          try { localStorage.setItem(STORAGE_KEY, pref); } catch (e) { }
        }
      }

      document.querySelectorAll(".theme-switch [data-theme-pref]").forEach(function (b) {
        b.addEventListener("click", function () {
          apply(b.getAttribute("data-theme-pref"), true);
        });
      });

      if (mq.addEventListener) {
        mq.addEventListener("change", function () {
          if (savedPref() === "auto") apply("auto", false);
        });
      }

      apply(savedPref(), false);

      // Copy code to clipboard
      function copyCode(btn) {
        const codeWindow = btn.closest('.code-window');
        const code = codeWindow.querySelector('pre code, pre').innerText;
        navigator.clipboard.writeText(code).then(() => {
          btn.innerText = "Copied!";
          setTimeout(() => { btn.innerText = "Copy"; }, 2000);
        }).catch(() => {
          // Fallback for older browsers
          const textarea = document.createElement('textarea');
          textarea.value = code;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
          btn.innerText = "Copied!";
          setTimeout(() => { btn.innerText = "Copy"; }, 2000);
        });
      }
    });
  </script>
</body>

</html>
