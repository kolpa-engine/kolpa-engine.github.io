<script>
document.addEventListener("DOMContentLoaded", () => {
  const terminal = document.getElementById("terminal-screen");
  const actions = {
    "btn-init-empty": {
      cmd: "kolpa create --template empty my-new-game",
      logs: [
        "Resolving template: empty...",
        "Creating workspace structure...",
        "Installing dependencies...",
        "Generating initial assembly file: base.csproj",
        "Setup completed. Run 'dotnet run --project my-new-game' to start editor."
      ]
    },
    "btn-init-3d": {
      cmd: "kolpa create --template action-rpg my-rpg-game",
      logs: [
        "Resolving template: 3d-action-rpg...",
        "Creating workspace structure...",
        "Copying assets (Models, Shaders, Soundpacks)...",
        "Configuring Jolt Physics layer...",
        "Initializing core scripts (PlayerController.cs, EnemyAI.cs)...",
        "Setup completed. Run 'dotnet run --project my-rpg-game' to launch game editor."
      ]
    },
    "btn-init-physics": {
      cmd: "kolpa create --template physics-demo demo-rigidbodies",
      logs: [
        "Resolving template: physics-demo...",
        "Configuring collision boundaries...",
        "Spawning 500 rigid body primitives (spheres, cubes)...",
        "Binding key bindings: [Space] to emit physics force...",
        "Setup completed. Run editor to simulate physics parameters."
      ]
    }
  };

  let typingTimer = null;

  function runSimulation(actionId) {
    if (typingTimer) clearInterval(typingTimer);
    
    // Clear terminal screen and show prompt typing
    terminal.innerHTML = "";
    
    // Disable buttons during animation
    const buttons = document.querySelectorAll(".sim-action-btn");
    buttons.forEach(btn => {
      btn.classList.remove("active");
      if (btn.id === actionId) btn.classList.add("active");
    });

    const status = document.querySelector(".sim-terminal .status-indicator");
    status.textContent = "Busy";
    status.className = "status-indicator busy";

    const item = actions[actionId];
    
    // Simulate command typing
    const promptLine = document.createElement("div");
    promptLine.className = "terminal-line";
    promptLine.innerHTML = `<span class="term-prompt">kolpa-user@desktop:~$</span> <span id="typing-cmd"></span><span class="term-cursor">_</span>`;
    terminal.appendChild(promptLine);

    const cmdSpan = document.getElementById("typing-cmd");
    let charIndex = 0;

    const typeCommand = setInterval(() => {
      cmdSpan.textContent += item.cmd[charIndex];
      charIndex++;
      if (charIndex >= item.cmd.length) {
        clearInterval(typeCommand);
        
        // Remove cursor from prompt line and simulate output
        promptLine.querySelector(".term-cursor").remove();
        
        // Display logs with simulated timing
        let logIndex = 0;
        const printLogs = setInterval(() => {
          if (logIndex < item.logs.length) {
            const line = document.createElement("div");
            line.className = "terminal-line";
            line.textContent = item.logs[logIndex];
            terminal.appendChild(line);
            logIndex++;
            terminal.scrollTop = terminal.scrollHeight;
          } else {
            clearInterval(printLogs);
            
            // Add new ready prompt line at the bottom
            const newPrompt = document.createElement("div");
            newPrompt.className = "terminal-line";
            newPrompt.innerHTML = `<span class="term-prompt">kolpa-user@desktop:~$</span> <span class="term-cursor">_</span>`;
            terminal.appendChild(newPrompt);
            terminal.scrollTop = terminal.scrollHeight;
            
            status.textContent = "Idle";
            status.className = "status-indicator";
          }
        }, 400);
      }
    }, 40);
  }

  // Bind click handlers to buttons
  Object.keys(actions).forEach(btnId => {
    document.getElementById(btnId).addEventListener("click", () => {
      runSimulation(btnId);
    });
  });

  // Run first simulation on load
  runSimulation("btn-init-empty");
});
</script>
