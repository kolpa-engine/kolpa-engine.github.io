---
layout: default
title: Page Not Found
description: The page you are looking for does not exist.
---

<div class="shell main-404-content" style="display: flex; align-items: center; justify-content: center; min-height: calc(80vh - var(--header-height)); padding: var(--spacing-xl) 0;">
  <div class="error-container" style="max-width: 540px; width: 100%; text-align: center; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--spacing-xl) var(--spacing-lg); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4); backdrop-filter: blur(10px);">
    
    <!-- Large Glowing Status Code -->
    <div class="glowing-code" style="font-size: 6rem; font-weight: 900; line-height: 1; color: var(--accent); text-shadow: 0 0 20px rgba(255, 152, 0, 0.3); margin-bottom: var(--spacing-md); font-family: var(--font-mono);">
      404
    </div>

    <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text); margin-bottom: var(--spacing-sm);">
      Page Not Found
    </h1>

    <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; margin-bottom: var(--spacing-lg);">
      The page you requested could not be found. It might have been moved, deleted, or the URL contains an error.
    </p>

    <!-- Error Diagnostic Terminal -->
    <div class="diagnostic-terminal" style="background: var(--bg-deep); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--spacing-md); text-align: left; margin-bottom: var(--spacing-lg); font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); overflow-x: auto;">
      <div style="color: var(--accent-light); margin-bottom: var(--spacing-xs); display: flex; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 4px;">
        <span>SYSTEM DIAGNOSTIC</span>
        <span style="color: var(--accent);">ERROR_ROUTE_NOT_FOUND</span>
      </div>
      <div>[KOLPA] Checking requested route mapping...</div>
      <div>[KOLPA] <span style="color: #ff3b30;">ERROR: Invalid router request handler path.</span></div>
      <div>[KOLPA] Stack Trace: Router.ResolveRoute() -> PageNotRegistered</div>
      <div class="console-blink" style="color: var(--text); margin-top: 4px;">$ <span id="route-output"></span><span style="animation: blink 1s step-end infinite;">_</span></div>
    </div>

    <!-- Actions -->
    <div style="display: flex; gap: var(--spacing-md); justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-outline" style="border-color: var(--accent); color: var(--accent); background: transparent;">Return to Home</a>
      <a href="/showcases/" class="btn btn-outline">Explore Showcases</a>
    </div>
  </div>
</div>

<style>
@keyframes blink {
  from, to { color: transparent }
  50% { color: var(--text) }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  // Extract and print the current invalid path to simulate debug terminal
  const invalidPath = window.location.pathname || "/unknown-route";
  const outputEl = document.getElementById("route-output");
  if (outputEl) {
    let index = 0;
    const text = `kolpa-engine --verify-route "${invalidPath}"`;
    function type() {
      if (index < text.length) {
        outputEl.textContent += text.charAt(index);
        index++;
        setTimeout(type, 50);
      }
    }
    type();
  }
});
</script>
