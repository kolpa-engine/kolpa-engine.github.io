---
layout: default
title: Modules
description: Discover official and community-maintained modules for Kolpa Engine.
---

<div class="page-header">
  <div class="shell header-content-layout">
    <div class="header-text-column">
      <h1 class="page-title">Modules</h1>
      <p class="lede">
        Extend the core engine with modular official features and community integrations.
      </p>
    </div>
    
    <div class="header-controls-column">
      <div class="tabs-container" role="tablist" aria-label="Module Categories">
        <button class="tab-btn active" id="tab-official" role="tab" aria-selected="true" aria-controls="panel-official">
          Official
        </button>
        <button class="tab-btn" id="tab-community" role="tab" aria-selected="false" aria-controls="panel-community">
          Community
        </button>
      </div>

      <div class="search-wrapper">
        <svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="module-search" class="search-input" placeholder="Search modules..." aria-label="Search modules" />
      </div>
    </div>
  </div>
</div>

<div class="shell main-modules-content">
  <!-- Modules Grid Content -->
  <div class="modules-grid-container">
    <!-- Official Modules Panel -->
    <div id="panel-official" class="modules-panel active" role="tabpanel" aria-labelledby="tab-official">
      <div class="modules-grid" id="grid-official">
        {% for module in data.modules %}
          {% if module.category == "official" %}
            <div class="module-card" data-name="{{ module.name | downcase }}" data-desc="{{ module.description | downcase }}" data-lang="{{ module.language | downcase }}">
              <div class="module-card-header">
                <div class="module-icon-box">
                  {% if module.icon == "cpu" %}
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="var(--accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="15" x2="23" y2="15"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="15" x2="4" y2="15"></line></svg>
                  {% elsif module.icon == "layout" %}
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="var(--accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                  {% elsif module.icon == "activity" %}
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="var(--accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                  {% elsif module.icon == "volume-2" %}
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="var(--accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="var(--accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                  {% endif %}
                </div>
                <div class="module-title-box">
                  <h3 class="module-name">{{ module.name }}</h3>
                  <span class="module-badge-lang">{{ module.language }}</span>
                </div>
              </div>
              <p class="module-desc">{{ module.description }}</p>
              <div class="module-actions">
                <a href="{{ module.repoUrl }}" class="module-btn secondary-btn" target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
                <button class="module-btn primary-btn view-details-btn" data-raw-url="{{ module.rawContentUrl }}" data-repo-url="{{ module.repoUrl }}" data-name="{{ module.name }}">
                  Details
                </button>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Community Modules Panel -->
    <div id="panel-community" class="modules-panel" role="tabpanel" aria-labelledby="tab-community" style="display: none;">
      <div class="modules-grid" id="grid-community">
        {% for module in data.modules %}
          {% if module.category == "community" %}
            <div class="module-card" data-name="{{ module.name | downcase }}" data-desc="{{ module.description | downcase }}" data-lang="{{ module.language | downcase }}">
              <div class="module-card-header">
                <div class="module-icon-box community-icon">
                  {% if module.icon == "map" %}
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="var(--text-muted)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon><line x1="9" y1="3" x2="9" y2="18"></line><line x1="15" y1="6" x2="15" y2="21"></line></svg>
                  {% elsif module.icon == "navigation" %}
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="var(--text-muted)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                  {% elsif module.icon == "tool" %}
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="var(--text-muted)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                  {% elsif module.icon == "message-square" %}
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="var(--text-muted)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="var(--text-muted)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                  {% endif %}
                </div>
                <div class="module-title-box">
                  <h3 class="module-name">{{ module.name }}</h3>
                  <span class="module-badge-lang">{{ module.language }}</span>
                </div>
              </div>
              <p class="module-desc">{{ module.description }}</p>
              <div class="module-actions">
                <a href="{{ module.repoUrl }}" class="module-btn secondary-btn" target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
                <button class="module-btn primary-btn view-details-btn" data-raw-url="{{ module.rawContentUrl }}" data-repo-url="{{ module.repoUrl }}" data-name="{{ module.name }}">
                  Details
                </button>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<!-- Details Modal -->
<div id="module-modal" class="modal-overlay" aria-hidden="true">
  <div class="modal-window" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-header">
      <h2 id="modal-title" class="modal-header-title">Module Documentation</h2>
      <button class="modal-close-btn" aria-label="Close details">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <div id="modal-loading-indicator" class="modal-loader">
        <div class="spinner"></div>
        <p>Fetching documentation...</p>
      </div>
      <div id="modal-error-content" class="modal-error" style="display: none;">
        <svg viewBox="0 0 24 24" width="40" height="40" stroke="var(--accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <h3>Could not load documentation</h3>
        <p>Rate limit exceeded or repo is offline.</p>
        <a id="modal-fallback-link" href="#" target="_blank" rel="noopener noreferrer" class="module-btn primary-btn" style="margin-top: var(--spacing-md); display: inline-flex; align-items: center; gap: 8px; width: auto; padding: 8px 16px;">
          View on GitHub
        </a>
      </div>
      <div id="modal-markdown-content" class="markdown-body"></div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<style>
/* CSS Styles */
.header-content-layout {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: var(--spacing-lg);
  flex-wrap: wrap;
  padding-bottom: var(--spacing-md);
}

.header-text-column {
  flex: 1;
  min-width: 280px;
}

.header-controls-column {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  flex-wrap: wrap;
}

.main-modules-content {
  padding-top: var(--spacing-xl);
  padding-bottom: var(--spacing-xl);
}

.tabs-container {
  display: flex;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  padding: 3px;
  border-radius: var(--radius);
}

.tab-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  padding: 6px 14px;
  font-family: var(--font-sans);
  font-size: 0.8rem;
  font-weight: 500;
  cursor: pointer;
  border-radius: var(--radius);
  transition: all 0.15s ease;
}

.tab-btn:hover {
  color: var(--text);
}

.tab-btn.active {
  background: var(--accent);
  color: #000;
  font-weight: 600;
}

.search-wrapper {
  position: relative;
  width: 200px;
}

.search-icon {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-dim);
  pointer-events: none;
}

.search-input {
  width: 100%;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  padding: 6px 10px 6px 32px;
  font-family: var(--font-sans);
  font-size: 0.8rem;
  outline: none;
  transition: border-color 0.15s ease;
}

.search-input:focus {
  border-color: var(--accent);
}

.modules-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: var(--spacing-md);
}

.module-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: var(--spacing-md);
  display: flex;
  flex-direction: column;
  height: 100%;
  transition: border-color 0.15s ease, transform 0.15s ease;
}

.module-card:hover {
  border-color: var(--accent);
  transform: translateY(-1px);
}

.module-card-header {
  display: flex;
  gap: var(--spacing-sm);
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.module-icon-box {
  background: var(--accent-soft);
  border: 1px solid rgba(255, 152, 0, 0.15);
  border-radius: var(--radius);
  padding: var(--spacing-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.module-icon-box.community-icon {
  background: rgba(255, 255, 255, 0.02);
  border-color: var(--border);
}

.module-title-box {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.module-name {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text);
  margin: 0;
}

.module-badge-lang {
  align-self: flex-start;
  font-size: 0.65rem;
  font-family: var(--font-mono);
  color: var(--accent);
  font-weight: 500;
}

.module-desc {
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.35;
  margin-bottom: var(--spacing-md);
  flex-grow: 1;
}

.module-actions {
  display: flex;
  gap: var(--spacing-sm);
  margin-top: auto;
}

.module-btn {
  flex: 1;
  padding: 6px var(--spacing-sm);
  font-size: 0.75rem;
  font-weight: 500;
  text-align: center;
  border-radius: var(--radius);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  font-family: var(--font-sans);
  border: none;
  transition: all 0.15s ease;
}

.primary-btn {
  background: var(--accent);
  color: #000;
}

.primary-btn:hover {
  background: var(--accent-light);
}

.secondary-btn {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-muted);
}

.secondary-btn:hover {
  border-color: var(--text-muted);
  color: var(--text);
}

/* Modal Styling */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(4px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.modal-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.modal-window {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  width: 90%;
  max-width: 720px;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(10px);
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-overlay.active .modal-window {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  border-bottom: 1px solid var(--border);
}

.modal-header-title {
  font-size: 1.1rem;
  font-weight: 700;
  margin: 0;
}

.modal-close-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
}

.modal-close-btn:hover {
  color: var(--text);
}

.modal-body {
  padding: var(--spacing-md);
  overflow-y: auto;
  flex-grow: 1;
}

.modal-loader {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg) 0;
  gap: var(--spacing-sm);
  color: var(--text-muted);
  font-size: 0.8rem;
}

.spinner {
  width: 20px;
  height: 20px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.modal-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg) 0;
  text-align: center;
}

.modal-error h3 {
  margin: var(--spacing-sm) 0 4px;
  color: var(--text);
  font-size: 0.95rem;
}

.modal-error p {
  color: var(--text-muted);
  font-size: 0.75rem;
  max-width: 260px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Modal Markdown Styling */
.markdown-body {
  color: var(--text-muted);
  line-height: 1.5;
  font-size: 0.85rem;
}

.markdown-body h1, .markdown-body h2, .markdown-body h3 {
  color: var(--text);
  margin-top: 1.2em;
  margin-bottom: 0.4em;
  font-weight: 700;
}

.markdown-body h1 { font-size: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.2em; }
.markdown-body h2 { font-size: 1.1rem; }
.markdown-body h3 { font-size: 0.95rem; }

.markdown-body p, .markdown-body ul, .markdown-body ol {
  margin-bottom: 0.8em;
}

.markdown-body code {
  font-family: var(--font-mono);
  background: rgba(255, 255, 255, 0.04);
  padding: 1px 4px;
  border-radius: 2px;
  font-size: 0.75rem;
  color: var(--text);
}

.markdown-body pre {
  background: var(--bg-deep);
  border: 1px solid var(--border);
  padding: var(--spacing-sm);
  border-radius: var(--radius);
  overflow-x: auto;
  margin-bottom: 0.8em;
}

.markdown-body pre code {
  background: transparent;
  padding: 0;
  border-radius: 0;
}

.markdown-body ul, .markdown-body ol {
  padding-left: var(--spacing-md);
}

.markdown-body blockquote {
  border-left: 2px solid var(--accent);
  padding-left: var(--spacing-sm);
  margin: 0 0 0.8em;
  color: var(--text-muted);
  font-style: italic;
}

@media (max-width: 768px) {
  .header-content-layout {
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-md);
  }
  
  .header-controls-column {
    justify-content: space-between;
    width: 100%;
  }

  .search-wrapper {
    flex-grow: 1;
    width: auto;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const tabs = {
    official: document.getElementById("tab-official"),
    community: document.getElementById("tab-community")
  };
  const panels = {
    official: document.getElementById("panel-official"),
    community: document.getElementById("panel-community")
  };
  const searchInput = document.getElementById("module-search");
  
  function switchTab(category) {
    Object.keys(tabs).forEach(key => {
      const active = key === category;
      tabs[key].classList.toggle("active", active);
      tabs[key].setAttribute("aria-selected", active ? "true" : "false");
      panels[key].style.display = active ? "block" : "none";
    });
    filterModules();
  }

  tabs.official.addEventListener("click", () => switchTab("official"));
  tabs.community.addEventListener("click", () => switchTab("community"));

  function filterModules() {
    const query = searchInput.value.toLowerCase().trim();
    const activePanel = panels.official.style.display !== "none" ? panels.official : panels.community;
    const cards = activePanel.querySelectorAll(".module-card");
    let visibleCount = 0;

    cards.forEach(card => {
      const name = card.getAttribute("data-name");
      const desc = card.getAttribute("data-desc");
      const lang = card.getAttribute("data-lang");
      
      const matches = name.includes(query) || desc.includes(query) || lang.includes(query);
      card.style.display = matches ? "flex" : "none";
      if (matches) visibleCount++;
    });

    let noResultsMsg = activePanel.querySelector(".no-results-message");
    if (visibleCount === 0) {
      if (!noResultsMsg) {
        noResultsMsg = document.createElement("p");
        noResultsMsg.className = "no-results-message error-message";
        noResultsMsg.style.textAlign = "center";
        noResultsMsg.style.marginTop = "var(--spacing-lg)";
        noResultsMsg.textContent = "No modules found.";
        activePanel.appendChild(noResultsMsg);
      }
    } else {
      if (noResultsMsg) {
        noResultsMsg.remove();
      }
    }
  }

  searchInput.addEventListener("input", filterModules);

  const modal = document.getElementById("module-modal");
  const modalTitle = document.getElementById("modal-title");
  const modalLoading = document.getElementById("modal-loading-indicator");
  const modalError = document.getElementById("modal-error-content");
  const modalFallbackLink = document.getElementById("modal-fallback-link");
  const modalContent = document.getElementById("modal-markdown-content");
  const modalCloseBtn = modal.querySelector(".modal-close-btn");

  function openModal(name, rawUrl, repoUrl) {
    modalTitle.textContent = `${name} Details`;
    modalLoading.style.display = "flex";
    modalError.style.display = "none";
    modalContent.innerHTML = "";
    
    modal.classList.add("active");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";

    fetch(rawUrl)
      .then(response => {
        if (!response.ok) throw new Error("Failed to load");
        return response.text();
      })
      .then(markdown => {
        modalLoading.style.display = "none";
        if (window.marked) {
          modalContent.innerHTML = window.marked.parse(markdown);
        } else {
          modalContent.innerHTML = `<pre style="white-space: pre-wrap;">${markdown}</pre>`;
        }
      })
      .catch(err => {
        console.error(err);
        modalLoading.style.display = "none";
        modalFallbackLink.href = repoUrl;
        modalError.style.display = "flex";
      });
  }

  function closeModal() {
    modal.classList.remove("active");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  document.querySelectorAll(".view-details-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      openModal(btn.getAttribute("data-name"), btn.getAttribute("data-raw-url"), btn.getAttribute("data-repo-url"));
    });
  });

  modalCloseBtn.addEventListener("click", closeModal);
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal.classList.contains("active")) {
      closeModal();
    }
  });
});
</script>
