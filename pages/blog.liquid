---
layout: default
title: Blog
description: News, tutorials, and development notes from the Kolpa Engine team.
---
<div class="page-header">
  <div class="shell">
    <h1 class="page-title">Blog</h1>
    <p class="lede">
      Development notes, tutorials, and occasional rants from the Kolpa Engine team.
    </p>
  </div>
</div>

<div class="shell blog-section">
  {% assign posts = collections.blog %}
  {% assign tagList = tagcloud.blog %}
  {% unless posts.size > 0 %}
    <p class="error-message">No posts yet. Check back soon.</p>
  {% else %}
    {% if tagList.size > 0 %}
      <nav class="tag-strip" aria-label="Browse by topic">
        <span class="tag-strip__label">Topics:</span>
        {% for tag in tagList %}
          <a class="tag tag--link" href="/blog/tags/{{ tag.slug }}/">{{ tag.name }}</a>
        {% endfor %}
        <a class="tag-strip__all" href="/tags/">all tags</a>
      </nav>
    {% endif %}

    <div class="blog-grid">
      {% for post in posts %}
        <article class="blog-card">
          <header class="blog-card__header">
            {% if post.date %}
              <time class="blog-card__date">{{ post.date | date_format: "MMMM d, yyyy" }}</time>
            {% endif %}
            <h2 class="blog-card__title">
              <a href="{{ post.url }}">{{ post.title }}</a>
            </h2>
            {% if post.description %}
              <p class="blog-card__desc">{{ post.description }}</p>
            {% endif %}
          </header>
          <footer class="blog-card__footer">
            <span class="post-meta">
              {% if post.author %}{{ post.author }} &middot; {% endif %}
              {{ post.content | read_time }} min read
            </span>
            {% for tag in post.tags %}
              <a class="tag tag--link" href="/blog/tags/{{ tag | slugify }}/">{{ tag }}</a>
            {% endfor %}
          </footer>
        </article>
      {% endfor %}
    </div>
  {% endunless %}
</div>
