---
layout: default
title: Meet the Team
description: The developers and open-source contributors building Kolpa Engine.
---

<div class="page-header">
  <div class="shell">
    <h1 class="page-title">MEET THE TEAM</h1>
    <p class="lede">
      Kolpa Engine is an open-source, community-driven project built by developers who believe in code autonomy, performance, and developer control.
    </p>
  </div>
</div>

<div class="shell">
  <section class="team-section">
    <h2 class="team-section-title">CORE MAINTAINERS</h2>
    <div class="team-grid">
      {% for member in data.team %}
        <div class="team-card">
          <div class="team-card-header">
            <img class="team-card-avatar" src="https://github.com/{{ member.username }}.png" alt="{{ member.name }}" loading="eager" />
            <div class="team-card-meta">
              <span class="team-card-name">{{ member.name }}</span>
              <span class="team-card-role">{{ member.role }}</span>
            </div>
          </div>
          <p class="team-card-bio">{{ member.bio }}</p>
          <div class="team-card-socials">
            <a href="{{ member.github }}" class="team-card-link" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub Profile
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  <section class="team-section" style="padding-top: 0;">
    <h2 class="team-section-title">OPEN SOURCE CONTRIBUTORS</h2>
    <div id="contributors-container" class="contributors-list">
      <!-- Skeleton placeholders; swapped for real entries below. -->
      <div class="skeleton-tag skeleton"></div>
      <div class="skeleton-tag skeleton"></div>
      <div class="skeleton-tag skeleton"></div>
      <div class="skeleton-tag skeleton"></div>
    </div>
  </section>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("contributors-container");
    const repo = "kolpa-engine/kolpa";
    const apiUrl = `https://api.github.com/repos/${repo}/contributors?per_page=100`;

    // Core devs to filter out from general contributors list to avoid duplicates
    const coreDevs = ["gabriel-aplok", "a6xdev", "lima6xcn"];

    // Static fallback contributors (names only)
    const fallbackContributors = [
      { login: "jrouwe", html_url: "https://github.com/jrouwe" },
      { login: "elalish", html_url: "https://github.com/elalish" },
      { login: "assimp", html_url: "https://github.com/assimp" }
    ];

    function renderContributors(contributors) {
      container.innerHTML = "";
      if (contributors.length === 0) {
        container.innerHTML = `<div class="error-message">No contributors found yet. Be the first to submit a pull request!</div>`;
        return;
      }

      contributors.forEach(c => {
        const link = document.createElement("a");
        link.href = c.html_url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className = "contributor-link";
        link.innerText = `@${c.login}`;
        container.appendChild(link);
      });
    }

    fetch(apiUrl)
      .then(response => {
        if (!response.ok) {
          throw new Error("Failed to fetch contributors from GitHub API");
        }
        return response.json();
      })
      .then(data => {
        // Filter out bots and core maintainers
        const otherContributors = data.filter(c =>
          c.type !== "Bot" && !coreDevs.includes(c.login.toLowerCase())
        );
        renderContributors(otherContributors);
      })
      .catch(error => {
        console.warn("GitHub API error, using fallback list:", error);
        renderContributors(fallbackContributors);
        const notice = document.createElement("div");
        notice.className = "error-message";
        notice.style.fontSize = "0.75rem";
        notice.style.marginTop = "var(--spacing-md)";
        notice.innerText = "Loaded static contributor list. GitHub API limit reached or offline.";
        container.parentElement.appendChild(notice);
      });
  });
</script>
