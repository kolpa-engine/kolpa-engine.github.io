{
  "site": {
    "title": "Kolpa Engine",
    "description": "A modular, hackable open-source game engine.",
    "url": "https://kolpa-engine.github.io"
  },
  "paths": {
    "pages": "pages",
    "layouts": "layouts",
    "content": "content",
    "data": "data",
    "assets": "assets",
    "output": "dist"
  },
  "renderer": {
    "engine": "liquid"
  },
  "rss": {
    "enabled": true,
    "collection": "blog",
    "output": "feed.xml",
    "link": "/blog/"
  },
  "collections": {
    "blog": {
      "source": "content/blog",
      "pattern": "*.md",
      "output": "/blog/{slug}/",
      "tags": "/blog/tags/{tag}/"
    }
  }
}
